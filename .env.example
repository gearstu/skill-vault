# 复制为 .env（仅供本地 netlify dev 调试用；Netlify 线上的变量在
# Site configuration → Environment variables 里配置，见 README 第 3 节）

# --- 前端（构建时注入，Netlify 上以 VITE_ 开头配置）---
# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx

# --- 服务端（只用于 Netlify Functions，不要放进前端代码）---
# Supabase → Settings → API → Project API keys → service_role
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.yyyyyyyyyyyyyyyy

# Storage bucket 名（默认 skillvault，与 schema.sql 一致）
SKILL_BUCKET=skillvault
